{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["\"", "\""]
  ],
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|([^\\s=;,\\[\\]]+)"
}
